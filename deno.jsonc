{
  "name": "@bernd/ts-zeug",
  "version": "1.5.9",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./mqtt/server": "./mqtt/Server.ts"
  },
  "tasks": {
    "dev": "deno run --watch mqtt-client.ts",
    "eslint": "deno run -A jsr:@sigmasd/deno-eslint",
    "test:runtimes": "deno run -A bun_node_test.ts"
  },
  "imports": {
    "@bernd/ts-zeug": "./mod.ts",
    "@std/async": "jsr:@std/async@^1.5.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.0"
  },
  "compilerOptions": {
    "strict": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "eqeqeq",
        "guard-for-in",
        "no-self-compare",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-useless-rename",
        "single-var-declarator"
      ]
    }
  },
  "test": {
    "exclude": [
      "bun_node_test.ts"
    ],
    "sanitizeOps": true,
    "sanitizeResources": true
  }
}
